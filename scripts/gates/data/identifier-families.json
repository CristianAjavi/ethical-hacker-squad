{
  "comment": "Identifier families a Traceability line may cite. A backticked token that matches none of these fails G4: the failure mode being caught is a fabricated identifier, which survives review by looking correct. Adding a standard means adding its family here, to docs/sources-allowlist.json and to NOTICE.md - deliberately three deliberate steps.",
  "verified": "2026-08-21",
  "families": {
    "OWASP Top 10": "A\\d{2}:20\\d{2}",
    "OWASP API Top 10": "API\\d{1,2}:20\\d{2}",
    "OWASP LLM Top 10": "LLM\\d{2}:20\\d{2}",
    "OWASP Agentic Top 10": "ASI\\d{2}",
    "OWASP ASVS": "ASVS \\d+\\.\\d+ V\\d{1,2}",
    "OWASP WSTG": "WSTG-[A-Z]{4}-(?:\\d{2}|\\*)",
    "OWASP MASVS": "MASVS-[A-Z]+-(?:\\d+|\\*)",
    "OWASP MASTG": "MAS(?:TG-TEST|WE)-(?:\\d{4}|\\*)",
    "OWASP CI/CD Top 10": "CICD-SEC-\\d{1,2}",
    "MITRE CWE": "CWE-\\d+",
    "MITRE CAPEC": "CAPEC-\\d+",
    "MITRE ATT&CK": "ATT&CK T\\d{4}(?:\\.\\d{3})?",
    "MITRE ATLAS": "AML\\.T\\d{4}(?:\\.\\d{3})?",
    "NIST SP 800-53": "NIST 800-53 [A-Z]{2}",
    "NIST SP publication": "NIST SP 800-\\d+[A-Za-z]?",
    "NIST AI": "NIST AI (?:RMF|\\d{3}-\\d[A-Za-z0-9]*)",
    "NIST SSDF practice": "SSDF (?:PO|PS|PW|RV)",
    "NIST SSDF task": "(?:PO|PS|PW|RV)\\.\\d+\\.\\d+",
    "SLSA": "SLSA (?:Build|Source) L\\d",
    "CSA CCM": "CCM [A-Z]{3}",
    "CIS Controls": "CIS v\\d+\\.\\d+ Control \\d{1,2}",
    "CIS Benchmarks": "CIS Benchmark[A-Za-z ]*",
    "PCI DSS": "PCI DSS v\\d+\\.\\d+(?:\\.\\d+)? req\\. \\d+",
    "OWASP Agentic Skills Top 10": "AST\\d{2}",
    "MITRE ATLAS mitigation": "AML\\.M\\d{4}"
  }
}
