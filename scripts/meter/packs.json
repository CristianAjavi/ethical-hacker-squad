{
  "schema": "ehs.meter.packs/v1",
  "comment": "Corpus layout, as DATA. The meter never guesses which file belongs to which pack: if a knowledge file exists on disk and is not declared here, the corpus section is reported UNMEASURED rather than silently under-counted.",
  "knowledge_dir": "skills/ethical-hacker-squad/references/knowledge",
  "non_procedure_files": [
    "README.md"
  ],
  "required_fields": [
    {
      "name": "where_to_look",
      "label": "Where to look",
      "pattern": "^\\*\\*Where to look\\*\\*"
    },
    {
      "name": "vulnerable_pattern",
      "label": "Vulnerable pattern",
      "pattern": "^\\*\\*Vulnerable pattern\\*\\*"
    },
    {
      "name": "rules_it_out",
      "label": "What rules it out (false positive)",
      "pattern": "^\\*\\*What rules it out \\(false positive\\)\\*\\*"
    },
    {
      "name": "minimal_test",
      "label": "Minimal test",
      "pattern": "^\\*\\*Minimal test\\*\\*"
    },
    {
      "name": "traceability",
      "label": "Traceability",
      "pattern": "^\\*\\*Traceability\\*\\*"
    },
    {
      "name": "tooling",
      "label": "Tooling",
      "pattern": "^\\*\\*Tooling\\*\\*"
    }
  ],
  "traceability_field": "traceability",
  "procedure_heading": "^### ([A-Z]+)-([0-9]+)\\b",
  "packs": [
    {
      "pack": "web-api",
      "role": "ehs-web-api",
      "id_prefixes": [
        "WEB"
      ],
      "files": [
        "web-api.md",
        "web-api-clientside-logic.md"
      ]
    },
    {
      "pack": "mobile",
      "role": "ehs-mobile",
      "id_prefixes": [
        "MOB"
      ],
      "files": [
        "mobile.md",
        "mobile-runtime-trust.md",
        "mobile-ios.md"
      ]
    },
    {
      "pack": "infra-cloud",
      "role": "ehs-infra-cloud",
      "id_prefixes": [
        "INF"
      ],
      "files": [
        "infra-cloud.md",
        "infra-cloud-cicd-exposure.md",
        "infra-cloud-cicd-platforms.md"
      ]
    },
    {
      "pack": "supply-chain",
      "role": "ehs-supply-chain",
      "id_prefixes": [
        "SUP"
      ],
      "files": [
        "supply-chain.md",
        "supply-chain-secrets-malware.md",
        "supply-chain-source-lifecycle.md"
      ]
    },
    {
      "pack": "ai-safety",
      "role": "ehs-ai-safety",
      "id_prefixes": [
        "AI"
      ],
      "files": [
        "ai-safety.md",
        "ai-safety-data-output.md",
        "ai-safety-agent-runtime.md"
      ]
    },
    {
      "pack": "privacy-abuse",
      "role": "ehs-privacy-abuse",
      "id_prefixes": [
        "PRV"
      ],
      "files": [
        "privacy-abuse.md"
      ]
    },
    {
      "pack": "remediation",
      "role": "ehs-remediator + ehs-verifier",
      "id_prefixes": [
        "REM",
        "VER"
      ],
      "files": [
        "remediation.md"
      ]
    },
    {
      "pack": "local-app",
      "role": "ehs-local-app",
      "id_prefixes": [
        "LOC"
      ],
      "files": [
        "local-app.md"
      ]
    }
  ],
  "hygiene_artifacts": [
    {
      "name": "LICENSE",
      "candidates": [
        "LICENSE",
        "LICENSE.md",
        "LICENSE.txt",
        "COPYING"
      ]
    },
    {
      "name": "SECURITY",
      "candidates": [
        "SECURITY.md",
        ".github/SECURITY.md",
        "docs/SECURITY.md"
      ]
    },
    {
      "name": "CONTRIBUTING",
      "candidates": [
        "CONTRIBUTING.md",
        ".github/CONTRIBUTING.md",
        "docs/CONTRIBUTING.md"
      ]
    },
    {
      "name": "CODEOWNERS",
      "candidates": [
        "CODEOWNERS",
        ".github/CODEOWNERS",
        "docs/CODEOWNERS"
      ]
    },
    {
      "name": "DEPENDABOT",
      "candidates": [
        ".github/dependabot.yml",
        ".github/dependabot.yaml"
      ]
    },
    {
      "name": "NOTICE",
      "candidates": [
        "NOTICE.md",
        "NOTICE"
      ]
    },
    {
      "name": "CHANGELOG",
      "candidates": [
        "CHANGELOG.md"
      ]
    },
    {
      "name": "PR_TEMPLATE",
      "candidates": [
        ".github/PULL_REQUEST_TEMPLATE.md",
        ".github/pull_request_template.md"
      ]
    }
  ],
  "workflows_dir": ".github/workflows",
  "gates_runner": "scripts/gates/run-all.sh",
  "baseline_file": "docs/coverage/baseline.json"
}
