# macOS
.DS_Store
._*

# Editores
.vscode/
.idea/
*.swp

# Entorno y secretos (nunca versionar)
.env
.env.*
# ...except the bench fixtures. bench/cases/ ships files that LOOK like the real
# thing on purpose: a .env.example of placeholders is a decoy the answer key
# declares, and excluding it silently made CI fail on a file that exists locally.
# gate-secret-scan.sh is what keeps this narrow: anything secret-shaped under
# bench/cases must be a defect the key declares.
!bench/cases/**/.env
!bench/cases/**/.env.*
# Same reason for editor and agent configuration: a case whose surface IS the
# repository-scoped configuration cannot ship with that configuration excluded.
!bench/cases/**/.vscode/
!bench/cases/**/.vscode/**
*.pem
*.key
*.p12
secrets/

# Salidas de auditoría locales, ANCLADAS A LA RAÍZ.
# Sin la barra inicial, `reports/` casa a cualquier profundidad: eso mantuvo
# fuera del commit la evidencia de una ronda entera del banco, en silencio, y
# el gate lo detectó dos veces sin que nada impidiera la tercera. Lo que se
# quiere ignorar es la salida local de una auditoría en la raíz del repo, no un
# directorio con ese nombre en cualquier sitio.
/out/
/reports/
*.log

# Python (los bancos de prueba de scripts/gh/tests/ son .py)
__pycache__/
*.pyc

# The Claude Code CLI the release workflow installs from tooling/claude-cli.
# What is versioned is the lock file; the tree it resolves to is not, and the
# `.bin/` symlink is built at install time to reach the platform binary that
# `--ignore-scripts` deliberately leaves unplaced.
tooling/claude-cli/node_modules/
tooling/claude-cli/.bin/
