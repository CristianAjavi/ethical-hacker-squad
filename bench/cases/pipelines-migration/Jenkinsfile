pipeline {
  agent { label 'build-linux' }

  environment {
    REGISTRY = 'registry.internal.example'
    CHANGE_BRANCH_SAFE = "${env.CHANGE_BRANCH}"
  }

  stages {
    stage('Announce') {
      steps {
        sh "echo 'Building change: ${env.CHANGE_TITLE}' >> build/announce.log"
        sh 'echo "branch=$CHANGE_BRANCH_SAFE" >> build/announce.log'
      }
    }

    stage('Build and publish') {
      steps {
        withCredentials([string(credentialsId: 'npm-publish-token', variable: 'NPM_TOKEN')]) {
          sh 'npm ci'
          sh './scripts/thirdparty-lint.sh'
          sh 'npm run build'
          sh 'npm publish --access public'
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'build/**', allowEmptyArchive: true
    }
  }
}
